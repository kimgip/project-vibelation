# Unified backend base, including /api. Empty keeps every feature in local Mock mode.
# Example: http://127.0.0.1:8000/api
VITE_API_URL=

# Legacy aliases (optional). Prefer VITE_API_URL; it takes precedence.
# VITE_GENERATION_API_URL also includes /api.
VITE_GENERATION_API_URL=
# VITE_REQUIREMENTS_API_URL accepts an origin such as http://127.0.0.1:8000.
VITE_REQUIREMENTS_API_URL=
