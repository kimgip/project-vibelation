# Optional Step 01 backend. Without this value, persistent local Mock jobs are used.
# Backend must implement the requirements API contract and accept the request IDs.
VITE_REQUIREMENTS_API_URL=

# Mock generation and legacy analysis backend (base ending in /api).
# Both POST requests send file=requirements.md, sourceFiles=ZIP files,
# sourceManifest=JSON role/hash/index metadata, and legacyVersion.
# Empty uses local fixtures; code is not sent to any server.
VITE_GENERATION_API_URL=
