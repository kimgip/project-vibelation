{
  "source": "mock",
  "renderer": "download-center-demo",
  "behaviors": [
    "최대 10개 선택",
    "언어 선택",
    "자료 검색·카테고리",
    "선택 다운로드 안내"
  ],
  "assumptions": [
    "다운로드 센터 고정 시연 시나리오",
    "실제 레거시 코드를 분석하거나 AI 코드를 실행한 결과가 아닙니다."
  ],
  "unconnectedFeatures": [
    "운영 API",
    "실제 ZIP 생성",
    "업무 데이터 저장",
    "실제 권한 검증"
  ],
  "html": "<!doctype html>\n<html lang=\"ko\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'; connect-src 'none'\">\n<title>시스템 적용 예상 화면 · 다운로드 센터</title>\n<style>*{box-sizing:border-box}body{margin:0;color:#173653;background:#fff;font:14px system-ui,sans-serif}header{padding:22px 32px;border-bottom:1px solid #dde5ee;display:flex;justify-content:space-between}header strong{font-size:22px}main{max-width:1000px;margin:auto;padding:42px 32px}h1{font-size:32px;margin:12px 0}p{color:#667b91}nav{display:flex;gap:22px;margin:30px 0 20px}button,input,select{font:inherit;padding:10px;border:1px solid #cbd9e8;border-radius:5px;background:white;color:inherit}button{cursor:pointer}button[aria-pressed=true]{color:#2463eb;border-color:#2463eb}#search{width:100%;background:#f1f5fa}.bar{display:flex;align-items:center;gap:12px;flex-wrap:wrap;padding:16px;background:#edf3ff;border:1px solid #a5c0ff;margin:20px 0}.bar button{background:#2463eb;color:white;margin-left:auto}#cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.card{border:1px solid #dbe5ef;padding:12px;cursor:pointer}.cover{display:block;background:linear-gradient(145deg,#a9bccc,#6a869c);color:white;font-size:22px;font-weight:700;padding:35px 18px;margin:10px 0;min-height:150px}.card small{display:block;margin-top:10px}#result{padding:16px;background:#f0f5ff;min-height:50px}footer{margin-top:24px;color:#708094;font-size:12px}@media(max-width:600px){#cards{grid-template-columns:repeat(2,minmax(0,1fr))}main{padding:24px 16px}header{padding:20px 16px}}</style></head>\n<body><header><strong>POSCO <small>제품 자료</small></strong><span>고객지원 / 다운로드 센터</span></header><main><small>CUSTOMER SUPPORT</small><h1>다운로드 센터</h1><p>필요한 제품 자료를 쉽고 빠르게 찾아보세요.</p>\n<nav><button data-category=\"catalog\" aria-pressed=\"true\">제품 카탈로그</button><button data-category=\"guide\" aria-pressed=\"false\">업무지원자료</button></nav>\n<input id=\"search\" aria-label=\"자료명 검색\" placeholder=\"자료명으로 검색\">\n<div class=\"bar\"><span id=\"count\">선택 자료 0 / 10</span><select id=\"language\" aria-label=\"언어\"><option>KOR</option><option>ENG</option></select><button id=\"download\">선택 다운로드</button></div>\n<div id=\"cards\"></div><p id=\"result\" role=\"status\">다운로드할 자료를 선택해주세요.</p>\n<label>시연할 다운로드 결과 <select id=\"scenario\"><option value=\"success\">성공</option><option value=\"partial\">일부 파일 누락</option><option value=\"failure\">실패</option></select></label>\n<footer>현업 협의용 시연 화면 · 실제 파일 다운로드와 운영 시스템 연결은 제공하지 않습니다.</footer></main>\n<script>\nconst names=['제품 종합 카탈로그','자동차 강판','에너지 강재','건축용 강재','스테인리스','전기강판','이용 가이드','품질 안내','인증 자료','주문 안내','기술 지원','자료 이용 안내'];\nconst selected=new Set();let category='catalog';const cards=document.getElementById('cards'),result=document.getElementById('result');\nfunction render(){cards.replaceChildren();const q=document.getElementById('search').value.toLowerCase();names.forEach((name,i)=>{if((category==='catalog' ? i>=6 : i<6)||!name.toLowerCase().includes(q))return;const label=document.createElement('label');label.className='card';const check=document.createElement('input');check.type='checkbox';check.checked=selected.has(i);check.setAttribute('aria-label',name);check.onchange=()=>{if(check.checked&&selected.size>=10){check.checked=false;result.textContent='최대 10개까지 선택할 수 있습니다.';return;}if(check.checked)selected.add(i);else selected.delete(i);document.getElementById('count').textContent='선택 자료 '+selected.size+' / 10';};const cover=document.createElement('span');cover.className='cover';cover.textContent='POSCO PRODUCT CATALOG';const text=document.createElement('small');text.textContent=name;label.append(check,cover,text);cards.append(label);});if(!cards.children.length)cards.textContent='검색 결과가 없습니다.';}\ndocument.querySelectorAll('[data-category]').forEach(button=>button.onclick=()=>{category=button.dataset.category;document.querySelectorAll('[data-category]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));render();});document.getElementById('search').oninput=render;\ndocument.getElementById('download').onclick=()=>{if(!selected.size){result.textContent='자료를 먼저 선택해주세요.';return;}const scenario=document.getElementById('scenario').value;result.textContent=scenario==='failure'?'다운로드에 실패했습니다. 다시 시도해주세요.':scenario==='partial'?'일부 파일이 누락되었습니다. 선택 자료를 확인해주세요.':selected.size+'개 자료의 '+document.getElementById('language').value+' 다운로드 준비가 완료되었습니다. (시연)';};render();\n</script></body></html>"
}
