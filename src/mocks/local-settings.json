  "filePolicy": {
    "maxBytes": 5242880,
    "maxCount": 5,
    "extensions": [
      "txt",
      "md",
      "html",
      "pdf",
      "docx",
      "pptx",
      "png",
      "jpg",
      "jpeg"
    ],
    "messages": {
      "count": "시연에서는 최대 {{count}}개 파일을 첨부할 수 있습니다.",
      "size": "{{name}}: 시연 파일당 최대 {{mib}}MiB입니다.",
      "extension": "{{name}}: 지원하지 않는 시연 파일 형식입니다."
    }
  },
  "timing": {
    "requirementReadyMs": 900,
    "systemMockReadyMs": 900,
    "analysisDelayMs": 500,
    "reportDelayMs": 500,
    "historyDelayMs": 200
  },
  "requirementFallbacks": {
    "text": "(미입력)",
    "html": "<!-- 미입력 -->",
    "attachments": "(없음)",
    "screenType": "미선택"
  },
  "screenTypes": [
    {
      "value": "new",
      "name": "신규",
      "detail": "레거시 스타일로 새 화면"
    },
    {
      "value": "modify",
      "name": "수정",
      "detail": "기존 화면에 추가"
    }
  ]
}
